{
  "$schema": "../../schema/livery.schema.json",
  "id": "herman",
  "airline": "RC1979",
  "name": "Herman (1979–84)",
  "kind": "standard",
  "from": "1979",
  "to": "1984-10",
  "confidence": "medium",
  "drawnOn": "MD82",
  "description": "Republic's first scheme: white, a broad light-blue band under the windows edged in navy below, a thinner light-blue band above the windows, both sweeping up and forward in a point behind the cockpit. 'REPUBLIC' in spaced navy capitals in a gap in the upper band. On the white fin, Herman: a navy ring with a flying duck across it, its long neck reaching forward and a wing raised behind. A navy and light-blue band runs up the fin's trailing edge. Worn by its DC-9s, MD-80s, 727s and Convair 580s until the 1984 'Republic' wordmark scheme.",
  "sources": [
    {
      "url": "https://commons.wikimedia.org/wiki/File:McDonnell_Douglas_DC-9-32,_Republic_Airlines_JP6652128.jpg",
      "title": "McDonnell Douglas DC-9-32, Republic Airlines (GFDL 1.2, Jon Proctor)",
      "accessed": "2026-11-23",
      "note": "N940N, left side, side-on, 1984: the bands, the nose sweep, the title and the fin measured on it."
    },
    {
      "url": "https://commons.wikimedia.org/wiki/File:McDonnell_Douglas_MD-82,_Republic_Airlines_JP6652136.jpg",
      "title": "McDonnell Douglas MD-82, Republic Airlines (GFDL 1.2, Jon Proctor)",
      "accessed": "2026-11-23",
      "note": "N305RC, right side, 1984: the same scheme on the MD-82, Herman on the fin."
    },
    {
      "url": "https://commons.wikimedia.org/wiki/File:Convair_CV-580_(7108318031).jpg",
      "title": "Republic Airlines Convair 580 N968N climbing out of Atlanta, 1982 (clipperarctic, CC BY-SA 2.0)",
      "accessed": "2026-11-24",
      "note": "Left side, from a little below and ahead, 1982: the scheme on the Convair 580 (types.CVLT). The only openly licensed photo found of a Republic Convair in this scheme."
    },
    {
      "url": "https://commons.wikimedia.org/wiki/File:Convair_580_Republic_AL_N90855_Sep_79_ORD.jpg",
      "title": "Republic Airlines Convair 580 N90855 at Chicago O'Hare, September 1979 (Richard Silagi, CC BY-SA 4.0)",
      "accessed": "2026-11-24",
      "note": "Evidence only: in 1979-80 Republic's Convairs (ex-North Central) first wore North Central's cheatline with Republic's titles and Herman (bare metal underside, a light-blue band through the windows, black radome; also N969N 1980, File:Convair CV-580, Republic Airlines JP6168775.jpg, GFDL). That interim look isn't this scheme and isn't drawn."
    }
  ],
