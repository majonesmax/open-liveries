{
  "$schema": "../../schema/livery.schema.json",
  "id": "standard",
  "airline": "MAA",
  "name": "mas (2022 livery)",
  "kind": "standard",
  "from": "2022",
  "confidence": "medium",
  "drawnOn": "A332",
  "description": "White A330 freighter with a big lowercase 'mas' in dark teal over the forward fuselage, a small striped green cube at its top-left and a Mexican flag behind the cockpit. The tail is a patchwork of fine green patterns (checks, stripes, dots and cubes in dark teal, mid green, lime and white) over the fin and the aft fuselage behind the wing, breaking up at its front into scattered small cubes; the engines and winglets carry the same patchwork. Drawn as a simplified patchwork of our own: big cube-face facets in the four tones over a mid-green ground, thirteen small light-green cubes ahead of it, not a trace of the artwork.",
  "sources": [
    {
      "url": "https://commons.wikimedia.org/wiki/File:EI-MYY_Airbus_A330-200F_MAS_Air_Cargo_Frankfurt_25.6.77_(52533671690).jpg",
      "title": "EI-MYY Airbus A330-200F MAS Air Cargo Frankfurt 25.6.77 (52533671690).jpg (CC BY-SA 2.0, Colin Cooke Photo)",
      "accessed": "2026-11-20",
      "note": "A330-200P2F EI-MYY, left side from below on approach to Frankfurt, 2022-06-25 (the file name's '25.6.77' is a typo for 2022: Commons dates it 2022-06-25). Fitted to shapes/A332.json (door 1 pinned, camera 8° below): the title, cube and flag, the pattern's front edges, the fin."
    },
    {
      "url": "https://commons.wikimedia.org/wiki/File:EI-MAA_(55091319501).jpg",
      "title": "EI-MAA (55091319501).jpg (CC BY-SA 4.0, Liam Thompson)",
      "accessed": "2026-11-20",
      "note": "A330-200 EI-MAA, left side from ahead, taxiing at LAX, 2026-02-11: the same scheme still worn in 2026 (title, cube, flag, patterned fin, aft fuselage and engines)."
    },
    {
      "url": "https://commons.wikimedia.org/wiki/File:MAS_Air_Cargo,_EI-MAE,_Airbus_A330-343(P2F)_(53213336866).jpg",
      "title": "MAS Air Cargo, EI-MAE, Airbus A330-343(P2F) (53213336866).jpg (CC BY-SA 2.0, Anna Zvereva)",
      "accessed": "2026-11-20",
      "note": "A330-300P2F EI-MAE, right side climbing out, 2023-08-17: the right side's patterned fin, aft fuselage and engines; this airframe (flown by Galistair Malta for MasAir) carried no 'mas' title then."
    }
  ],
