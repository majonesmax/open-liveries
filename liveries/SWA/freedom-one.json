{
  "$schema": "../../schema/livery.schema.json",
  "id": "freedom-one",
  "airline": "SWA",
  "name": "Freedom One (US flag)",
  "kind": "special",
  "from": "2021",
  "description": "Fuselage: US flag: forward fuselage and nose navy blue with scattered white stars (blue canton) back to about the wing leading edge; aft of that red and white stripes ripple along the fuselage to the tail in irregular folds (gray shading on the white). Cheatlines: the flag's stripes instead. Tail: from June 2026 Independence One's fin (navy, a white band and a red band along the leading edge and tip on the Heart's lines) with white 'Southwest'; the Heart fin before. Engines: navy at the front; aft of a diagonal edge, red, white and red flag stripes over the cowling; no stars on the cowling. Winglets: navy with '250' (2026; gray before). Titles: 'Southwest' white on the lower fin; 'Freedom One' small under the cockpit until 2026, replaced in 2026 by the America250 mark ('AMERICA' over '250'). Artwork: US flag. Colors hex: approximate.",
  "confidence": "medium",
  "drawnOn": "B738",
