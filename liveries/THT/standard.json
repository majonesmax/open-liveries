      "height": 0.47,
      "length": 0.279,
      "color": "white",
      "style": "Big white light capitals over the forward windows (the windows show through), the first and last door each framed by a thin white box round a letter (A and I on the left, T and I on the right).",
      "type": {
        "similar": [
          "Optima",
          "Albertus"
        ],
        "weight": 500,
        "slantDeg": 0,
        "width": "normal",
        "strokes": "contrast",
